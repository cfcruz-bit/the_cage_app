# Copia este archivo a `.env` y ajusta los valores.
# `.env` esta en el .gitignore: nunca lo subas.

ENVIRONMENT=development
DEBUG=true

# Desarrollo: SQLite. Produccion: postgresql+asyncpg://usuario:clave@host/base
DATABASE_URL=sqlite+aiosqlite:///./cage.db

# Genera una de verdad con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiame-en-serio-antes-de-desplegar
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Panel web del coach. La app movil no necesita CORS.
# CORS_ORIGINS=["http://localhost:5173"]
