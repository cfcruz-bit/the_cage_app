{
  "name": "@cage/engine",
  "version": "0.1.0",
  "description": "Motor de autorregulacion de The Cage 2.0: progresion por RIR, ajuste de hard sets por feedback y planificacion set a set.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "golden",
    "docs",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "golden": "tsx scripts/generate-golden.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
